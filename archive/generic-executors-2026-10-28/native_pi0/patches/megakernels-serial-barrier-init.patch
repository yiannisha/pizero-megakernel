+                arrive(page_finished[page][i], count);
+            }
+        }
 #ifdef KITTENS_BLACKWELL
         init_semaphore(tensor_finished, config::NUM_CONSUMER_WARPS);
-        arrive(tensor_finished,
-               config::NUM_CONSUMER_WARPS); // Flip to state 0, to mark that it
